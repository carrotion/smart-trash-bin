+int& Explore::getFailureCount(const geometry_msgs::msg::Point& goal)
+{
+  constexpr static size_t tolerace = 5;
+  nav2_costmap_2d::Costmap2D* costmap2d = costmap_client_.getCostmap();
+
+  for (auto& entry : frontier_failure_counts_) {
+    double x_diff = fabs(goal.x - entry.first.x);
+    double y_diff = fabs(goal.y - entry.first.y);
+
+    if (x_diff < tolerace * costmap2d->getResolution() &&
+        y_diff < tolerace * costmap2d->getResolution())
+      return entry.second;
+  }
+  frontier_failure_counts_.push_back({goal, 0});
+  return frontier_failure_counts_.back().second;

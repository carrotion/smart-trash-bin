[Unit]
Description=Smart Trash Bin - IMU publisher node (ICM-20948)
After=network.target

[Service]
Type=simple
User=carrotian
WorkingDirectory=/home/carrotian/catkin_ws
# ⚠️ 하드아이언 보정값은 **1호기 전용**이다. 기체마다 철재/배선 배치가 달라서
#    2호기에 그대로 쓰면 안 된다 — tools/mag_calibrate.py로 기체별 재측정 필요.
#    2026-08-19 재측정(재배선/재배치 후): ox=-88.68 oy=+12.81
#      샘플 2880, 커버리지 100%, 지구자기장 반지름 27.84µT(한국 약 30), 잔차 2.06µT(7.4%)
#    ⚠️ 편향이 08-17(-0.44/+14.37)에서 크게 바뀌었다 — 재배치로 강한 자기원이 생겼다.
#       거의 전부 -X(전후 축) 성분이다. 다만 **일정하므로 보정으로 완전히 제거된다**
#       (원 반지름이 지구 자기장과 일치하는 것이 그 증거).
#    ⚠️ 레이아웃을 바꾸면 반드시 재측정할 것: tools/hand_rotation_check.py
#
# 자이로 Z 바이어스: 2026-08-21엔 1회 실측(-0.00782, 90초/3066샘플) 상수를
#    고정으로 썼는데, 2026-08-29에 이게 EKF(=SLAM이 쓰는 요 추정)로 직접
#    들어가는 유일한 경로임에도 재부팅해도 안 바뀌는 일주일 넘은 값이었다는
#    걸 발견함 — diff_drive_node는 매 시작마다 재보정하는데 그 결과가 EKF엔
#    전혀 안 갔음. 오늘 관측된 맵 왜곡(62.8°/-30.3°)의 유력 원인.
#    → gyro_bias_auto_calibrate(기본 true)로 이 노드도 매 시작 100샘플
#    자동 재보정하도록 변경(imu_publisher_node.py). gyro_bias_z=-0.00782는
#    이제 auto_calibrate를 끌 때만 쓰이는 비교/폴백용으로 남겨둠 — 상세는
#    docs/midterm_review_20260829.md, docs/audit/2026-08-29_gyro_thermal_*.md
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/carrotian/catkin_ws/install/setup.bash && exec ros2 run smart_trash_sensors imu_publisher_node --ros-args -p mag_hard_iron_x:=-88.68 -p mag_hard_iron_y:=12.81 -p gyro_bias_z:=-0.00782 -p gyro_bias_auto_calibrate:=true'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

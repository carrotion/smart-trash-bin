[Unit]
Description=Smart Trash Bin - static TF base_link -> imu_link (required for EKF IMU fusion)
After=network.target

[Service]
Type=simple
User=carrotian
WorkingDirectory=/home/carrotian/catkin_ws
# 2026-08-29 발견: 이 정적 TF가 아예 없어서 EKF가 IMU 메시지를 전부
# "Could not transform measurement into base_link. Ignoring..."로 버리고
# 있었다(10바퀴 정밀 회전 시험 + robot_localization debug 로그로 확인,
# processMeasurement(imu0_*)가 5초간 0회 — odom0는 1302회). vyaw만 쓰니까
# 장착 위치가 무관해서 TF도 필요 없다고 잘못 판단했던 게 원인
# (hardware_inventory.md 2026-08-21 기록, 정정 필요) — robot_localization은
# 어떤 필드를 쓰든 프레임 변환 자체를 먼저 시도하므로 TF가 없으면 메시지
# 전체가 버려진다. 좌표는 hardware_inventory.md "IMU 장착 기하"
# (2026-08-21 재배치, base_link 기준 x=+105mm, y=0, z=90mm, 회전 없음).
# 인자 순서(구형식, deprecated 경고는 무해): x y z yaw pitch roll parent child.
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && exec ros2 run tf2_ros static_transform_publisher 0.105 0 0.090 0 0 0 base_link imu_link'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

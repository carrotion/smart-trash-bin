[Unit]
Description=Smart Trash Bin - IMU/LiDAR status dashboard (subscribes to imu_publisher_node + lidar node)
After=network.target smart-trash-imu.service smart-trash-lidar.service
Wants=smart-trash-imu.service smart-trash-lidar.service

[Service]
Type=simple
User=carrotian
WorkingDirectory=/home/carrotian/smart-trash-bin
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source /home/carrotian/catkin_ws/install/setup.bash && exec python3 tools/sensor_dashboard.py --port 8767'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
